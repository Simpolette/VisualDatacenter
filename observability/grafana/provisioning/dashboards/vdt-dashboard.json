      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "editorMode": "code",
          "expr": "rate(frontend_ui_lag_count_total[1m])",
          "legendFormat": "Lag Rate (per sec)",
          "range": true,
          "refId": "A"
